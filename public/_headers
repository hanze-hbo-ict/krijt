# Security headers for Cloudflare Pages / Netlify.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Comparison pages of the diagnostics page (public/diagnostics/README.md): only
# the isolation headers differ from Krijt's own. Krijt sends none, so its own
# page already is the no-isolation case.
/diagnostics/isolated/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

/diagnostics/credentialless/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless
